# /opt/tz-review/deploy/.env on the server. deploy.sh rewrites WITH_LLM, LITE, SITE_DOMAIN, HOST_IP, REVIEW_BASIC_AUTH
# and keeps everything else (login keys, allowlist, SESSION_SECRET) untouched.
WITH_LLM=0
LITE=1
SITE_DOMAIN=185-17-3-218.sslip.io
HOST_IP=185.17.3.218
SESSION_SECRET=generated-by-deploy
# Yandex ID: https://oauth.yandex.ru/client/new  -> Redirect URI: https://185-17-3-218.sslip.io/auth/yandex/callback
AUTH_YANDEX_CLIENT_ID=
AUTH_YANDEX_CLIENT_SECRET=
# Google: https://console.cloud.google.com/apis/credentials -> OAuth client (Web) -> redirect https://185-17-3-218.sslip.io/auth/google/callback
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
# optional allowlist
AUTH_ALLOWED_DOMAINS=
AUTH_ALLOWED_EMAILS=
